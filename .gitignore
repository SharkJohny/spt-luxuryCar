/node_modules

# OMC operational state (akýkoľvek .omc/ adresár v strome)
.omc/

# Vzorkovník — stiahnuté originály obrázkov (re-fetchable cez `yarn vzorky:fetch`).
# Commitujeme len výsledný blok vzorky/dist/vzorky-shoptet.html, nie ~9 MB zdrojov.
/vzorky/images/
.shoptet-tool/

# Truck konfigurátor — generované ľahké verzie (base64 → URL); regeneruje
# `yarn truck:images` (beží aj v build:once). Zdroj = konfigurator*.jsx s base64.
/assets/js/truck-konfigurator/konfigurator.gen.jsx
/assets/js/truck-konfigurator/konfigurator.phone.gen.jsx

# Pracovné poznámky a zadania pre agentov — nepatria do repa (push = deploy).
# REVIEWS-HANDOFF.md obsahuje GitHub token -> nikdy necommitovať.
/REVIEWS-HANDOFF.md
/codex-task-*.txt

# Samostatné časti bundla (functions/lcdCasti.js) — stavia ich CI, necommitovať
/assets/js/lcd-truck.js
/assets/js/lcd-gsap.js
/assets/js/lcd-reels.js
/assets/js/lcd-hp.js
/assets/css/luxuryCar.min.css

# Recenzie Google (tools/scrape-google-reviews.mjs): diagnostické snímky a zoznam nedostupných fotiek
/tools/_scrape-*.png
/tools/reviews-dead.json
# Spoločné dáta recenzií — vyrába ich len CI (tools/reviews-spolocne.mjs), necommitovať
/assets/data/
# Fixtures offline testu one page checkoutu: kópie súborov Shoptetu (main-3g.js, checkout-3g.js, HTML krokov s inline
# skriptami) nesmú byť v repe (VOP Shoptet 07/2026 čl. 11.3). Vyrobiť lokálne podľa tools/test-opc/FIXTURES.md.
/tools/test-opc/fixtures/
