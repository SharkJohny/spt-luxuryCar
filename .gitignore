/node_modules

# OMC operational state (akýkoľvek .omc/ adresár v strome)
.omc/

# Vzorkovník — stiahnuté originály obrázkov (re-fetchable cez `yarn vzorky:fetch`).
# Commitujeme len výsledný blok vzorky/dist/vzorky-shoptet.html, nie ~9 MB zdrojov.
/vzorky/images/
.shoptet-tool/

# Truck konfigurátor — generované ľahké verzie (base64 → URL); regeneruje
# `yarn truck:images` (beží aj v build:once). Zdroj = konfigurator*.jsx s base64.
/assets/js/truck-konfigurator/konfigurator.gen.jsx
/assets/js/truck-konfigurator/konfigurator.phone.gen.jsx

# Pracovné poznámky a zadania pre agentov — nepatria do repa (push = deploy).
# REVIEWS-HANDOFF.md obsahuje GitHub token -> nikdy necommitovať.
/REVIEWS-HANDOFF.md
/codex-task-*.txt
